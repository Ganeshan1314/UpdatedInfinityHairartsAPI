{
  "ConnectionStrings": {
    "dbconnection": "Server=<server>;Database=InfinityHairArtsAdmin;User Id=<user>;Password=<password>;TrustServerCertificate=True;"
  },
  "FilePaths": {
    "BasePath": "D:/GitHub/InfinityHairArtsWebApplication/",
    "userProfilePicturePath": "/Uploads/UserProfilePicture/"
  },
  "Session": {
    "IdleTimeoutMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Fcm": {
    "ProjectId": "infinity-hair-arts",
    "ServiceAccountJson": "firebase-service-account.json"
  },
  "Notifications": {
    "MinutesBefore": 30,
    "PollingIntervalSeconds": 60,
    "TimeZoneId": "Asia/Kolkata"
  },
  "AllowedHosts": "*",
  "ShowCustomerImage": "/Images/HairCutItemListImages/",
  "TwiloaccountSid": "<twilio-account-sid>",
  "TwiloauthToken": "<twilio-auth-token>"
}
