{
  "ConnectionStrings": {
    "dbconnection": "Server=<server>;Database=InfinityHairArtsAdmin;User Id=<user>;Password=<password>;TrustServerCertificate=True;"
  },
  "Session": {
    "IdleTimeoutMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "Logs",
    "MinimumLevel": "Information",
    "RetainedDays": 30
  },
  "Fcm": {
    "ProjectId": "infinity-hair-arts",
    "ServiceAccountJson": "firebase-service-account.json"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<your-hosted-admin-web-origin-if-any>"
    ]
  },
  "ServiceImages": {
    "Directory": "<folder the CUSTOMER API serves /Images/HairCutItemListImages from, e.g. D:/inetpub/InfinityHairartsAPI/Images/HairCutItemListImages>"
  },
  "OwnerNotifications": {
    "PushWorkerEnabled": true
  },
  "Authentication": {
    "KeyRingPath": "App_Data/DataProtectionKeys"
  },
  "AllowedHosts": "*",
  "SalonImages": {
    "Directory": "<folder for signup salon photos, e.g. D:/inetpub/SalonexaAdminAPI/SalonImages>"
  },
  "AdminAppUpdates": {
    "Android": {
      "LatestVersionCode": 7,
      "LatestVersion": "1.1.2"
    }
  }
}