{
  "ConnectionStrings": {
    "dbconnection": "PASTE the same dbconnection value from the customer API's appsettings.json on the server"
  },
  "ServiceImages": {
    "Directory": "D:/HostedApps/InfinityHairArtsAPI/Images/HairCutItemListImages"
  },
  "Session": {
    "IdleTimeoutMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "Logs",
    "MinimumLevel": "Information",
    "RetainedDays": 30
  },
  "OwnerNotifications": {
    "PushWorkerEnabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
