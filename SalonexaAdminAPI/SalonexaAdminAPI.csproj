<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SalonexaAdminAPI</AssemblyName>
    <RootNamespace>SalonexaAdminAPI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mandatory-update policy served by GET api/AppUpdates/salonexa-admin/android. Set AdminAppUpdates:Android
         in the server's appsettings.json to override it without redeploying this file. -->
    <Content Update="admin-app-updates.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the server's own connection settings and Firebase credentials when publishing. -->
    <Content Update="appsettings*.json;*firebase-adminsdk-*.json;firebase-service-account.json" CopyToPublishDirectory="Never" />
    <Content Update="**/*.sql" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
  </ItemGroup>

</Project>
